<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0;net9.0;net11.0</TargetFrameworks>
    <!-- Build Apple-specific targets on macOS hosts (both ARM64 and x64). -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(TargetFrameworks);net10.0-ios;net11.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <RootNamespace>NativeCompressions</RootNamespace>
    <Description>Core binding of native Zstandard high-performance streaming compression for .NET.</Description>

    <!-- NuGet -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- iOS links native libraries statically, so DllImport must use __Internal. -->
  <PropertyGroup Condition="'$(TargetPlatformIdentifier)' == 'ios'">
    <DefineConstants>$(DefineConstants);__IOS__</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared internals, only the ones Zstandard actually uses. -->
    <Compile Include="..\NativeCompressions.LZ4.Core\Internal\Throws.cs" Link="Internal\Throws.cs" />
    <Compile Include="..\NativeCompressions.LZ4.Core\Internal\SegmentedArrayProvider.cs" Link="Internal\SegmentedArrayProvider.cs" />
    <!-- netstandard2.1 polyfills: Array.MaxLength, GC.AllocateUninitializedArray, ValueTask.FromCanceled, File.OpenHandle -->
    <Compile Include="..\NativeCompressions.LZ4.Core\Internal\Polyfill\StaticExtensions.cs" Link="Internal\Polyfill\StaticExtensions.cs" />
    <!-- pre .NET 8 polyfill for Stream.BeginRead / BeginWrite -->
    <Compile Include="..\NativeCompressions.LZ4.Core\Internal\Polyfill\TaskToAsyncResult.cs" Link="Internal\Polyfill\TaskToAsyncResult.cs" />
    <!-- netstandard2.1 reads a SafeFileHandle through a FileStream without taking ownership of the handle -->
    <Compile Include="..\NativeCompressions.LZ4.Core\Internal\NonOwningFileStream.cs" Link="Internal\NonOwningFileStream.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework) == 'netstandard2.1'">
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageReference Include="System.IO.Pipelines" Version="9.0.8" />
    <PackageReference Include="System.Threading.Channels" Version="9.0.8" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.IO.Pipelines" Version="9.0.8" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="9.0.8" />
  </ItemGroup>

</Project>
