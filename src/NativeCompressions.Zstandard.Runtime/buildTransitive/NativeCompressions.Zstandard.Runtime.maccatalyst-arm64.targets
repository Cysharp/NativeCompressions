<Project>
  <!-- Select the target RID, never the host architecture. Libraries propagate this
       target to the app instead of embedding another copy of the static archive. -->
  <PropertyGroup Condition="'$(TargetFramework)' != '' and '$(IsCrossTargetingBuild)' != 'true' and '$(TargetPlatformIdentifier)' == 'maccatalyst' and '$(RuntimeIdentifier)' == 'maccatalyst-arm64' and '$(OutputType)' == 'Exe'">
    <_NativeCompressionsZstandardCatalystArm64Archive>$(MSBuildThisFileDirectory)../runtimes/maccatalyst-arm64/native/libzstd.a</_NativeCompressionsZstandardCatalystArm64Archive>
  </PropertyGroup>
  <ItemGroup Condition="'$(_NativeCompressionsZstandardCatalystArm64Archive)' != ''">
    <NativeReference Include="$(_NativeCompressionsZstandardCatalystArm64Archive)">
      <Kind>Static</Kind>
    </NativeReference>
  </ItemGroup>
  <Target Name="CheckNativeCompressionsZstandardCatalystArm64" BeforeTargets="PrepareForBuild"
          Condition="'$(_NativeCompressionsZstandardCatalystArm64Archive)' != ''">
    <Error Condition="!Exists('$(_NativeCompressionsZstandardCatalystArm64Archive)')"
           Text="NativeCompressions.Zstandard.Runtime.maccatalyst-arm64 is missing its Catalyst archive: $(_NativeCompressionsZstandardCatalystArm64Archive). Restore the package again." />
  </Target>
</Project>
