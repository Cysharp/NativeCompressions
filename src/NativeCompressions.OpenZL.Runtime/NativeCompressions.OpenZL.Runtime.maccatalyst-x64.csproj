<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
    <Description>OpenZL static native runtime for Mac Catalyst x64.</Description>
    <!-- OpenZL packages are only enabled explicitly by the local smoke pack. -->
  </PropertyGroup>
  <ItemGroup>
    <None Remove="runtimes/**;buildTransitive/**" />
    <None Include="runtimes/maccatalyst-x64/native/libopenzl.a" Pack="true" PackagePath="runtimes/maccatalyst-x64/native/" />
    <None Include="buildTransitive/NativeCompressions.OpenZL.Runtime.maccatalyst-x64.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NativeCompressions.LZ4.Runtime/NativeCompressions.LZ4.Runtime.maccatalyst-x64.csproj" />
    <ProjectReference Include="../NativeCompressions.Zstandard.Runtime/NativeCompressions.Zstandard.Runtime.maccatalyst-x64.csproj" />
  </ItemGroup>
</Project>
