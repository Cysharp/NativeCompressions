<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Intentionally no reference to NativeCompressions (Core / Runtime).
    The native libraries are called through this project's own P/Invoke declarations (NativeMethods.cs),
    so a result depends only on the native binary, not on the managed wrapper or its packaging.
  -->

</Project>
