<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-maccatalyst</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>CatalystSmoke</AssemblyName>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <SmokeArchitecture Condition="'$(SmokeArchitecture)' == ''">arm64</SmokeArchitecture>
    <RuntimeIdentifier>maccatalyst-$(SmokeArchitecture)</RuntimeIdentifier>
    <ApplicationId>com.cysharp.nativecompressions.catalystsmoke</ApplicationId>
    <ApplicationTitle>NativeCompressions Catalyst Smoke</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <CodesignKey>-</CodesignKey>
    <EnableCodeSigning>true</EnableCodeSigning>
    <IsPackable>false</IsPackable>
    <SmokeReferenceMode Condition="'$(SmokeReferenceMode)' == ''">meta</SmokeReferenceMode>
    <SmokePackageVersion Condition="'$(SmokePackageVersion)' == ''">0.0.0-catalyst-phase2</SmokePackageVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SmokeReferenceMode)' == 'transitive' or '$(SmokeReferenceMode)' == 'duplicate'">
    <DefineConstants>$(DefineConstants);SMOKE_MIDDLE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(SmokeReferenceMode)' == 'direct' or '$(SmokeReferenceMode)' == 'duplicate'">
    <PackageReference Include="NativeCompressions.LZ4.Core" Version="$(SmokePackageVersion)" />
    <PackageReference Include="NativeCompressions.LZ4.Runtime.maccatalyst-$(SmokeArchitecture)" Version="$(SmokePackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(SmokeReferenceMode)' == 'meta' or '$(SmokeReferenceMode)' == 'duplicate'">
    <PackageReference Include="NativeCompressions.LZ4" Version="$(SmokePackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(SmokeReferenceMode)' == 'transitive' or '$(SmokeReferenceMode)' == 'duplicate'">
    <PackageReference Include="CatalystSmoke.Middle" Version="$(SmokePackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Middle/**;Tools/**" />
  </ItemGroup>
  <Target Name="VerifySmokeNativeReference" BeforeTargets="PrepareForBuild">
    <Error Condition="'@(NativeReference->Count())' != '1'" Text="Expected exactly one NuGet NativeReference, got @(NativeReference)." />
    <Error Condition="'%(NativeReference.Kind)' != 'Static'" Text="Expected static NativeReference." />
    <Error Condition="$([System.String]::Copy('%(NativeReference.Identity)').Contains('$(RuntimeIdentifier)')) != 'True'" Text="Expected $(RuntimeIdentifier) archive: %(NativeReference.Identity)" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)native-references.txt" Lines="@(NativeReference->'%(FullPath)|%(Kind)')" Overwrite="true" />
  </Target>
</Project>
