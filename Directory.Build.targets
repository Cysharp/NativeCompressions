<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Symbol packages only for packages that contain an assembly.
       Runtime and meta packages have no build output, and an snupkg without content fails to pack (NU5017). -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true' and '$(IncludeBuildOutput)' != 'false'">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
